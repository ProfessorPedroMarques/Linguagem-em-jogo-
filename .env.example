# Copie este arquivo para ".env" e ajuste. NUNCA envie o ".env" para o repositório.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Banco SQLite (arquivo local). Em testes é usado ":memory:".
DATABASE_PATH=./data/linguagem.db

# Endereço do front-end (usado em links de recuperação de senha)
APP_URL=http://localhost:5173

# Origens autorizadas a chamar a API pelo navegador (separe por vírgula)
CORS_ORIGINS=http://localhost:5173

# Sessão
COOKIE_NAME=lj_session
# Em produção (HTTPS) deixe true
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=120

# Cadastro público de professores e responsáveis (em produção o padrão é false)
ALLOW_PUBLIC_REGISTRATION=true

# Proteção contra força bruta e abuso
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Defina true somente se a API estiver atrás de um proxy reverso confiável
TRUST_PROXY=false

LOG_LEVEL=info

# Seed (opcional): e-mail do administrador. Se ADMIN_PASSWORD não for definida,
# uma senha aleatória é gerada e mostrada UMA vez no terminal.
ADMIN_EMAIL=admin@linguagem.local
# ADMIN_PASSWORD=
